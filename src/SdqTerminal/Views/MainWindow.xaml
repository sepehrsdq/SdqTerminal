<Window x:Class="SdqTerminal.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:local="clr-namespace:SdqTerminal"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="SdqTerminal"
        Icon="/SdqTerminal;component/Assets/SdqTerminal.ico"
        Width="980"
        Height="620"
        MinWidth="480"
        MinHeight="300"
        UseLayoutRounding="True"
        Background="{DynamicResource TerminalBackgroundBrush}"
        WindowStyle="None"
        ResizeMode="CanResize"
        Loaded="Window_Loaded"
        Closed="Window_Closed"
        SizeChanged="Window_SizeChanged"
        SourceInitialized="Window_SourceInitialized"
        PreviewKeyDown="Window_PreviewKeyDown">
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="52"
                            ResizeBorderThickness="6"
                            CornerRadius="10"
                            GlassFrameThickness="0"
                            UseAeroCaptionButtons="False" />
    </shell:WindowChrome.WindowChrome>

    <Window.Resources>
        <ResourceDictionary>
        <ResourceDictionary.MergedDictionaries>
            <ResourceDictionary Source="/SdqTerminal;component/Controls/TerminalScrollBar.xaml" />
        </ResourceDictionary.MergedDictionaries>
        <Style TargetType="Separator">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Separator">
                        <Border Height="1" Background="{DynamicResource SeparatorBrush}" Margin="10,5" />
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="DarkSubmenuItemStyle"
               TargetType="MenuItem">
            <Setter Property="ItemContainerStyleSelector" Value="{DynamicResource DarkMenuContainerSelector}" />
            <Setter Property="Background"
                    Value="Transparent" />
            <Setter Property="Foreground"
                    Value="{DynamicResource ChromeForegroundBrush}" />
            <Setter Property="BorderBrush"
                    Value="Transparent" />
            <Setter Property="Padding"
                    Value="8,5" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="MenuItem">
                        <Grid Background="Transparent">
                            <Border x:Name="ItemBackground"
                                    Margin="3,1"
                                    Padding="{TemplateBinding Padding}"
                                    Background="{TemplateBinding Background}"
                                    CornerRadius="4">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="22" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="18" />
                                    </Grid.ColumnDefinitions>

                                    <TextBlock x:Name="CheckMark"
                                               Text="✓"
                                               Foreground="{TemplateBinding Foreground}"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center"
                                               Visibility="Collapsed" />
                                    <ContentPresenter Grid.Column="1"
                                                      ContentSource="Header"
                                                      RecognizesAccessKey="True"
                                                      VerticalAlignment="Center" />
                                    <TextBlock x:Name="SubmenuArrow"
                                               Grid.Column="2"
                                               Text="›"
                                               FontSize="16"
                                               Foreground="{TemplateBinding Foreground}"
                                               HorizontalAlignment="Right"
                                               VerticalAlignment="Center"
                                               Visibility="Collapsed" />
                                </Grid>
                            </Border>

                            <Popup x:Name="PART_Popup"
                                   Placement="Right"
                                   HorizontalOffset="-3"
                                   IsOpen="{TemplateBinding IsSubmenuOpen}"
                                   AllowsTransparency="True"
                                   Focusable="False"
                                   PopupAnimation="Fade">
                                <Border MinWidth="180"
                                        Padding="3"
                                        Background="{DynamicResource MenuBackgroundBrush}"
                                        BorderBrush="{DynamicResource MenuBorderBrush}"
                                        BorderThickness="1"
                                        CornerRadius="6">
                                    <ScrollViewer CanContentScroll="True" VerticalScrollBarVisibility="Auto"
                                                  HorizontalScrollBarVisibility="Disabled" MaxHeight="480">
                                        <ItemsPresenter KeyboardNavigation.DirectionalNavigation="Cycle" />
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="Role"
                                     Value="SubmenuHeader">
                                <Setter TargetName="SubmenuArrow"
                                        Property="Visibility"
                                        Value="Visible" />
                            </Trigger>
                            <Trigger Property="IsChecked"
                                     Value="True">
                                <Setter TargetName="CheckMark"
                                        Property="Visibility"
                                        Value="Visible" />
                            </Trigger>
                            <Trigger Property="IsHighlighted"
                                     Value="True">
                                <Setter TargetName="ItemBackground"
                                        Property="Background"
                                        Value="{DynamicResource MenuHighlightBrush}" />
                                <Setter Property="Foreground"
                                        Value="{DynamicResource ChromeStrongForegroundBrush}" />
                            </Trigger>
                            <Trigger Property="IsEnabled"
                                     Value="False">
                                <Setter Property="Opacity"
                                        Value="0.45" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="DarkTopLevelMenuItemStyle"
               TargetType="MenuItem">
            <Setter Property="Background"
                    Value="Transparent" />
            <Setter Property="Foreground"
                    Value="{DynamicResource ChromeForegroundBrush}" />
            <Setter Property="ItemContainerStyleSelector"
                    Value="{DynamicResource DarkMenuContainerSelector}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="MenuItem">
                        <Grid>
                            <Border x:Name="HeaderBackground"
                                    Margin="2,2"
                                    Padding="10,4"
                                    Background="{TemplateBinding Background}"
                                    CornerRadius="4">
                                <ContentPresenter ContentSource="Header"
                                                  RecognizesAccessKey="True"
                                                  VerticalAlignment="Center" />
                            </Border>

                            <Popup x:Name="PART_Popup"
                                   Placement="Bottom"
                                   VerticalOffset="-2"
                                   IsOpen="{TemplateBinding IsSubmenuOpen}"
                                   AllowsTransparency="True"
                                   Focusable="False"
                                   PopupAnimation="Fade">
                                <Border MinWidth="190"
                                        Padding="3"
                                        Background="{DynamicResource MenuBackgroundBrush}"
                                        BorderBrush="{DynamicResource MenuBorderBrush}"
                                        BorderThickness="1"
                                        CornerRadius="6">
                                    <ScrollViewer CanContentScroll="True" VerticalScrollBarVisibility="Auto"
                                                  HorizontalScrollBarVisibility="Disabled" MaxHeight="480">
                                        <ItemsPresenter KeyboardNavigation.DirectionalNavigation="Cycle" />
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsHighlighted"
                                     Value="True">
                                <Setter TargetName="HeaderBackground"
                                        Property="Background"
                                        Value="{DynamicResource MenuHighlightBrush}" />
                                <Setter Property="Foreground"
                                        Value="{DynamicResource ChromeStrongForegroundBrush}" />
                            </Trigger>
                            <Trigger Property="IsSubmenuOpen"
                                     Value="True">
                                <Setter TargetName="HeaderBackground"
                                        Property="Background"
                                        Value="{DynamicResource MenuOpenBrush}" />
                                <Setter Property="Foreground"
                                        Value="{DynamicResource ChromeStrongForegroundBrush}" />
                            </Trigger>
                            <Trigger Property="IsEnabled"
                                     Value="False">
                                <Setter Property="Opacity"
                                        Value="0.45" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="DarkContextMenuStyle"
               TargetType="ContextMenu">
            <Setter Property="Background"
                    Value="{DynamicResource MenuBackgroundBrush}" />
            <Setter Property="Foreground"
                    Value="{DynamicResource ChromeForegroundBrush}" />
            <Setter Property="BorderBrush"
                    Value="{DynamicResource MenuBorderBrush}" />
            <Setter Property="BorderThickness"
                    Value="1" />
            <Setter Property="Padding"
                    Value="3" />
            <Setter Property="ItemContainerStyleSelector"
                    Value="{DynamicResource DarkMenuContainerSelector}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ContextMenu">
                        <Border MinWidth="180"
                                Padding="{TemplateBinding Padding}"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6">
                            <ScrollViewer CanContentScroll="True" VerticalScrollBarVisibility="Auto"
                                          HorizontalScrollBarVisibility="Disabled" MaxHeight="480">
                                <ItemsPresenter KeyboardNavigation.DirectionalNavigation="Cycle" />
                            </ScrollViewer>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="WindowCaptionButtonStyle"
               TargetType="Button">
            <Setter Property="Foreground"
                    Value="{DynamicResource ChromeForegroundBrush}" />
            <Setter Property="Background"
                    Value="Transparent" />
            <Setter Property="BorderThickness"
                    Value="0" />
            <Setter Property="HorizontalContentAlignment"
                    Value="Center" />
            <Setter Property="VerticalContentAlignment"
                    Value="Center" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="CaptionBackground"
                                Background="{TemplateBinding Background}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver"
                                     Value="True">
                                <Setter TargetName="CaptionBackground"
                                        Property="Background"
                                        Value="{DynamicResource CaptionHoverBrush}" />
                            </Trigger>
                            <Trigger Property="IsPressed"
                                     Value="True">
                                <Setter TargetName="CaptionBackground"
                                        Property="Background"
                                        Value="{DynamicResource CaptionPressedBrush}" />
                            </Trigger>
                            <MultiTrigger>
                                <MultiTrigger.Conditions>
                                    <Condition Property="IsMouseOver"
                                               Value="True" />
                                    <Condition Property="Tag"
                                               Value="Close" />
                                </MultiTrigger.Conditions>
                                <Setter TargetName="CaptionBackground"
                                        Property="Background"
                                        Value="#c42b1c" />
                                <Setter Property="Foreground"
                                        Value="#ffffff" />
                            </MultiTrigger>
                            <MultiTrigger>
                                <MultiTrigger.Conditions>
                                    <Condition Property="IsPressed"
                                               Value="True" />
                                    <Condition Property="Tag"
                                               Value="Close" />
                                </MultiTrigger.Conditions>
                                <Setter TargetName="CaptionBackground"
                                        Property="Background"
                                        Value="#a92316" />
                            </MultiTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="DarkTitleButtonStyle"
               TargetType="Button">
            <Setter Property="Foreground"
                    Value="{DynamicResource ChromeForegroundBrush}" />
            <Setter Property="Background"
                    Value="Transparent" />
            <Setter Property="BorderThickness"
                    Value="0" />
            <Setter Property="Cursor"
                    Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ButtonBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                Padding="{TemplateBinding Padding}"
                                CornerRadius="7">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="ButtonBorder" Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                                <Setter TargetName="ButtonBorder" Property="BorderThickness" Value="1" />
                            </Trigger>
                            <Trigger Property="IsMouseOver"
                                     Value="True">
                                <Setter TargetName="ButtonBorder"
                                        Property="Background"
                                        Value="{DynamicResource MenuHighlightBrush}" />
                            </Trigger>
                            <Trigger Property="IsPressed"
                                     Value="True">
                                <Setter TargetName="ButtonBorder"
                                        Property="Background"
                                        Value="{DynamicResource ButtonPressedBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <local:MenuContainerStyleSelector x:Key="DarkMenuContainerSelector"
            MenuItemStyle="{StaticResource DarkSubmenuItemStyle}"
            SeparatorStyle="{StaticResource {x:Type Separator}}" />
        <Style x:Key="ChromeTabButtonStyle" TargetType="Button" BasedOn="{StaticResource DarkTitleButtonStyle}">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="FocusBorder" Padding="{TemplateBinding Padding}" Background="Transparent" BorderBrush="Transparent" BorderThickness="1" CornerRadius="8">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="FocusBorder" Property="BorderBrush" Value="{DynamicResource FocusBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="RtlChipStyle" TargetType="Button" BasedOn="{StaticResource DarkTitleButtonStyle}">
            <Setter Property="Height" Value="26" />
            <Setter Property="Padding" Value="10,0,9,0" />
            <Setter Property="Margin" Value="6,0,0,0" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Chip"
                                Background="{DynamicResource ChipBackgroundBrush}"
                                BorderBrush="{DynamicResource ChipBorderBrush}"
                                BorderThickness="1"
                                CornerRadius="13"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Chip" Property="Background" Value="{DynamicResource RoundButtonHoverBrush}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Chip" Property="Background" Value="{DynamicResource RoundButtonPressedBrush}" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Chip" Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="PaletteItemStyle" TargetType="ListBoxItem">
            <Setter Property="Padding" Value="10,7" />
            <Setter Property="Foreground" Value="{DynamicResource PaletteForegroundBrush}" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="RowBorder"
                                Background="Transparent"
                                CornerRadius="7"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="RowBorder" Property="Background" Value="{DynamicResource PaletteSelectionBrush}" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="RowBorder" Property="Background" Value="{DynamicResource PaletteSelectionBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="TrafficLightStyle" TargetType="Button">
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Foreground" Value="Transparent" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid>
                            <Ellipse Fill="{TemplateBinding Background}" Stroke="#22000000" StrokeThickness="0.6" />
                            <ContentPresenter x:Name="Glyph" Opacity="0" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Glyph" Property="Opacity" Value="0.75" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Glyph" Property="Opacity" Value="0.75" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="ChromeRoundButtonStyle" TargetType="Button" BasedOn="{StaticResource DarkTitleButtonStyle}">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Circle" CornerRadius="16" Background="Transparent">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Circle" Property="Background" Value="{DynamicResource RoundButtonHoverBrush}" /></Trigger>
                            <Trigger Property="IsPressed" Value="True"><Setter TargetName="Circle" Property="Background" Value="{DynamicResource RoundButtonPressedBrush}" /></Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Circle" Property="Background" Value="{DynamicResource RoundButtonFocusBrush}" /></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        </ResourceDictionary>
    </Window.Resources>

    <Border>
        <Border.Style>
            <Style TargetType="Border">
                <Setter Property="Padding" Value="0" />
                <Style.Triggers>
                    <DataTrigger Binding="{Binding WindowState, RelativeSource={RelativeSource AncestorType=Window}}" Value="Maximized">
                        <Setter Property="Padding" Value="8,8,8,12" />
                    </DataTrigger>
                </Style.Triggers>
            </Style>
        </Border.Style>
    <Grid>
    <DockPanel Background="{DynamicResource TerminalBackgroundBrush}">
        <Grid DockPanel.Dock="Top"
              Height="52"
              Background="{DynamicResource TitleBarBrush}">
            <DockPanel LastChildFill="True">
                <StackPanel DockPanel.Dock="Left"
                            Orientation="Horizontal"
                            VerticalAlignment="Center"
                            Margin="18,0,0,0"
                            shell:WindowChrome.IsHitTestVisibleInChrome="True">
                    <Button x:Name="CloseLightButton" Width="13" Height="13" Margin="0,0,8,0"
                            Background="#FF5F57" Style="{StaticResource TrafficLightStyle}"
                            Click="CloseWindowButton_Click" ToolTip="Close" AutomationProperties.Name="Close window">
                        <Path Data="M0,0 L5,5 M5,0 L0,5" Stroke="#5c110b" StrokeThickness="1.3" />
                    </Button>
                    <Button x:Name="MinimizeLightButton" Width="13" Height="13" Margin="0,0,8,0"
                            Background="#FEBC2E" Style="{StaticResource TrafficLightStyle}"
                            Click="MinimizeButton_Click" ToolTip="Minimize" AutomationProperties.Name="Minimize">
                        <Path Data="M0,2.5 L5,2.5" Stroke="#8a5a06" StrokeThickness="1.3" />
                    </Button>
                    <Button x:Name="MaximizeLightButton" Width="13" Height="13"
                            Background="#28C840" Style="{StaticResource TrafficLightStyle}"
                            Click="MaximizeButton_Click" ToolTip="Maximize / Restore" AutomationProperties.Name="Maximize or restore">
                        <Path Data="M1,1 L5,5 M5,1 L1,5" Stroke="#0a5c17" StrokeThickness="1.3" />
                    </Button>
                </StackPanel>

                <StackPanel DockPanel.Dock="Right"
                            Orientation="Horizontal"
                            VerticalAlignment="Center"
                            Margin="0,0,12,0"
                            shell:WindowChrome.IsHitTestVisibleInChrome="True">
                    <Button x:Name="MacroStopButton" Margin="0,0,4,0" Visibility="Collapsed" Width="26" Height="26" Content="■" Style="{StaticResource WindowCaptionButtonStyle}" Click="MacroStop_Click" ToolTip="Stop playback (Ctrl+Shift+Alt+End)" AutomationProperties.Name="Stop macro"/>
                    <Button x:Name="MacroStepButton" Margin="0,0,4,0" Visibility="Collapsed" Width="26" Height="26" Content="▸|" Style="{StaticResource WindowCaptionButtonStyle}" Click="MacroStep_Click" ToolTip="Run one step, then pause" AutomationProperties.Name="Run one macro step"/>
                    <Button x:Name="MacroPauseButton" Margin="0,0,4,0" Visibility="Collapsed" Width="26" Height="26" Content="Ⅱ" Style="{StaticResource WindowCaptionButtonStyle}" Click="MacroPause_Click" ToolTip="Pause / resume (Ctrl+Shift+Alt+P)" AutomationProperties.Name="Pause or resume macro"/>
                    <Button x:Name="MacroStatusButton" Margin="0,0,6,0" Visibility="Collapsed" Padding="6,0" Height="26" Style="{StaticResource WindowCaptionButtonStyle}" Click="MacroStatus_Click" ToolTip="Stop recording / pause playback" AutomationProperties.Name="Macro status"/>

                    <Button x:Name="SearchButton" Width="30" Height="28" Margin="0,0,2,0"
                            Style="{StaticResource WindowCaptionButtonStyle}"
                            Click="SearchButton_Click"
                            ToolTip="Find in terminal (Ctrl+F)" AutomationProperties.Name="Find in terminal">
                        <Viewbox Width="15" Height="15">
                            <Path Data="M6.2,1 A5.2,5.2 0 1 0 6.2,11.4 A5.2,5.2 0 1 0 6.2,1 M10.2,10.2 L14,14"
                                  Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                  StrokeThickness="1.4" StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                        </Viewbox>
                    </Button>

                    <ToggleButton x:Name="DarkModeButton" Width="30" Height="28" Margin="0,0,2,0"
                                  IsChecked="True" Click="DarkModeButton_Click" ToolTip="Switch to light appearance"
                                  AutomationProperties.Name="Dark mode">
                        <ToggleButton.Style>
                            <Style TargetType="ToggleButton">
                                <Setter Property="Foreground" Value="{DynamicResource ChromeForegroundBrush}"/>
                                <Setter Property="Background" Value="Transparent"/>
                                <Setter Property="BorderBrush" Value="Transparent"/>
                                <Setter Property="BorderThickness" Value="0"/>
                                <Setter Property="Template"><Setter.Value>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <Border x:Name="ButtonBorder" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="6">
                                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsChecked" Value="True"><Setter Property="Foreground" Value="{DynamicResource AccentBrush}"/></Trigger>
                                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="ButtonBorder" Property="Background" Value="{DynamicResource CaptionHoverBrush}"/></Trigger>
                                            <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="ButtonBorder" Property="Background" Value="{DynamicResource CaptionHoverBrush}"/></Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value></Setter>
                            </Style>
                        </ToggleButton.Style>
                        <Path Width="15" Height="15" Stretch="Uniform" Data="M12,1 A7,7 0 1 0 15,12 A7,7 0 0 1 12,1 Z"
                              Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ToggleButton}}"/>
                    </ToggleButton>

                    <Button x:Name="RtlChipButton"
                            Style="{StaticResource RtlChipStyle}"
                            Click="RtlChipButton_Click"
                            ToolTip="Right-to-left text: Smart RTL picks the direction per line"
                            AutomationProperties.Name="Right-to-left mode">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock x:Name="RtlChipGlyph"
                                       Text="ا"
                                       FontSize="13"
                                       FontWeight="SemiBold"
                                       Margin="0,0,7,0"
                                       VerticalAlignment="Center"
                                       Foreground="{DynamicResource AccentBrush}" />
                            <TextBlock x:Name="RtlChipText"
                                       Text="Smart RTL"
                                       FontSize="11.5"
                                       FontWeight="SemiBold"
                                       VerticalAlignment="Center"
                                       Foreground="{DynamicResource ChromeStrongForegroundBrush}" />
                            <Path Data="M0,0 L3.5,3.6 L7,0"
                                  Stroke="{DynamicResource MutedForegroundBrush}"
                                  StrokeThickness="1.2"
                                  StrokeStartLineCap="Round"
                                  StrokeEndLineCap="Round"
                                  Margin="7,2,0,0"
                                  VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>

                    <Menu x:Name="MainMenu" Height="30" Margin="4,0,0,0" FontFamily="Segoe UI" FontSize="12"
                          Background="Transparent"
                          Foreground="{DynamicResource ChromeForegroundBrush}"
                          ItemContainerStyle="{StaticResource DarkTopLevelMenuItemStyle}">
                        <MenuItem Header="☰" FontSize="15" Padding="11,3" AutomationProperties.Name="Application menu">
                            <MenuItem Header="New _terminal" InputGestureText="Ctrl+Shift+T"
                                      Click="NewTabButton_Click" />
                            <MenuItem Header="Fi_nd in terminal…" InputGestureText="Ctrl+F"
                                      Click="SearchMenuItem_Click" />
                            <MenuItem Header="_Command palette…" InputGestureText="Ctrl+Shift+P"
                                      Click="PaletteMenuItem_Click" />
                            <Separator />
                            <MenuItem Header="_File">
                                <MenuItem x:Name="OpenDirectoryMenuItem"
                                          Header="_Open current directory in Explorer"
                                          Click="OpenDirectoryMenuItem_Click" />
                                <Separator />
                                <MenuItem x:Name="LastDirectoriesMenuItem"
                                          Header="_Last directories"
                                          SubmenuOpened="LastDirectoriesMenuItem_SubmenuOpened">
                                    <MenuItem Header="No recent directories"
                                              IsEnabled="False" />
                                </MenuItem>
                                <Separator />
                                <MenuItem Header="_Export session…"
                                          Click="ExportSessionMenuItem_Click" />
                                <MenuItem Header="Preview in _browser"
                                          Click="HtmlPreviewButton_Click" />
                                <Separator />
                                <MenuItem Header="E_xit"
                                          Click="ExitMenuItem_Click" />
                            </MenuItem>
                            <MenuItem Header="_View">
                                <MenuItem x:Name="SplitPaneMenuItem" Header="_Split pane" InputGestureText="Ctrl+Shift+D"
                                          Click="SplitPaneMenuItem_Click" />
                                <MenuItem x:Name="JoinTabMenuItem" Header="Show _tab side by side"
                                          SubmenuOpened="JoinTabMenuItem_SubmenuOpened">
                                    <MenuItem Header="No other tabs" IsEnabled="False" />
                                </MenuItem>
                                <MenuItem x:Name="MovePaneMenuItem" IsEnabled="False" Header="_Move pane to a new tab"
                                          Click="MovePaneMenuItem_Click" />
                                <MenuItem x:Name="ClosePaneMenuItem" Header="Close _pane" InputGestureText="Ctrl+Shift+W"
                                          Click="ClosePaneMenuItem_Click" />
                                <Separator />
                                <MenuItem x:Name="SmartRtlMenuItem"
                                          Header="_Smart RTL (auto per line)"
                                          IsCheckable="True"
                                          ToolTip="Use right-to-left layout only for lines containing RTL letters"
                                          Checked="SmartRtlMenuItem_Changed"
                                          Unchecked="SmartRtlMenuItem_Changed" />
                                <MenuItem x:Name="RowRtlMenuItem" Header="Row RTL (every line)"
                                          IsCheckable="True" IsChecked="False"
                                          ToolTip="Force right-to-left direction and right alignment for every row, including full-screen applications. This may move application borders."
                                          Checked="SmartRtlMenuItem_Changed" Unchecked="SmartRtlMenuItem_Changed" />
                                <Separator />
                                <MenuItem x:Name="ThemeMenuItem" Header="_Theme…" Click="ThemeMenuItem_Click" />
                                <Separator />
                                <MenuItem Header="Increase _font size" InputGestureText="Ctrl+Plus" Click="IncreaseFontSizeMenuItem_Click" />
                                <MenuItem Header="_Decrease font size" InputGestureText="Ctrl+Minus" Click="DecreaseFontSizeMenuItem_Click" />
                                <MenuItem Header="_Reset font size" InputGestureText="Ctrl+0" Click="ResetFontSizeMenuItem_Click" />
                                <Separator />
                                <MenuItem Header="_Settings…" Click="FontSettingsMenuItem_Click" />
                            </MenuItem>
                            <MenuItem Header="_Tools">
                                <MenuItem Header="_Macros" SubmenuOpened="MacroMenu_Opened">
                                    <MenuItem x:Name="MacroRecordMenuItem" Header="_Start recording" Click="MacroRecord_Click"/>
                                    <MenuItem x:Name="MacroStopMenuItem" Header="Stop playback" IsEnabled="False" Click="MacroStop_Click"/>
                                    <Separator/>
                                    <MenuItem x:Name="MacroRunMenu" Header="_Run"><MenuItem Header="No recorded macros" IsEnabled="False"/></MenuItem>
                                    <MenuItem Header="_Manage recorded macros…" Click="MacroManage_Click"/>
                                    <MenuItem Header="Macro _settings…" Click="MacroSettings_Click"/>
                                </MenuItem>
                                <MenuItem x:Name="ContextMenuIntegrationMenuItem"
                                          Header="Add _Open in SdqTerminal"
                                          IsCheckable="True"
                                          Click="ContextMenuIntegrationMenuItem_Click" />
                            </MenuItem>
                            <MenuItem Header="_Help">
                                <MenuItem Header="_Guide" Click="GuideMenuItem_Click" />
                                <MenuItem x:Name="CheckForUpdatesMenuItem"
                                          Header="Check for _updates…"
                                          Click="CheckForUpdatesMenuItem_Click" />
                                <Separator />
                                <MenuItem Header="_About SdqTerminal"
                                          Click="AboutMenuItem_Click" />
                            </MenuItem>
                            <Separator />
                            <MenuItem Header="Close _window" InputGestureText="Alt+F4" Click="CloseWindowButton_Click" />
                        </MenuItem>
                    </Menu>
                </StackPanel>

                <DockPanel x:Name="TitleTabsHost" Margin="12,0,10,0" LastChildFill="False"
                           SizeChanged="TitleTabsHost_SizeChanged">
                    <ScrollViewer x:Name="TabScroller" DockPanel.Dock="Left" VerticalScrollBarVisibility="Disabled"
                                  VerticalAlignment="Center"
                                  PreviewMouseWheel="TabScroller_PreviewMouseWheel"
                                  HorizontalScrollBarVisibility="Hidden">
                        <StackPanel x:Name="TabStrip" Orientation="Horizontal"
                                    shell:WindowChrome.IsHitTestVisibleInChrome="True" />
                    </ScrollViewer>
                    <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" Margin="4,0,0,0" VerticalAlignment="Center"
                                shell:WindowChrome.IsHitTestVisibleInChrome="True">
                        <Button x:Name="NewTabButton" Width="28" Height="26" Content="+" FontSize="18"
                                HorizontalContentAlignment="Center" ToolTip="New terminal (Ctrl+Shift+T)"
                                Style="{StaticResource ChromeRoundButtonStyle}" Click="NewTabButton_Click"
                                AutomationProperties.Name="New terminal" />
                        <Button Width="22" Height="26" Content="⌄" FontSize="12"
                                HorizontalContentAlignment="Center" ToolTip="Terminal profiles"
                                Style="{StaticResource DarkTitleButtonStyle}" Click="ProfileMenuButton_Click"
                                AutomationProperties.Name="Terminal profiles" />
                    </StackPanel>
                </DockPanel>
            </DockPanel>
        </Grid>

        <Border DockPanel.Dock="Top" Height="1" Background="{DynamicResource HeaderSeparatorBrush}" />

        <Border DockPanel.Dock="Bottom" Height="26" Background="{DynamicResource StatusBarBrush}"
                BorderBrush="{DynamicResource HeaderSeparatorBrush}" BorderThickness="0,1,0,0">
            <Grid Margin="14,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="StatusProfileText"
                           Text="PowerShell"
                           FontSize="11"
                           FontWeight="SemiBold"
                           VerticalAlignment="Center"
                           Foreground="{DynamicResource StatusBarForegroundBrush}" />
                <TextBlock x:Name="StatusDirectoryText"
                           Grid.Column="1"
                           Text=""
                           Margin="10,0,10,0"
                           FontFamily="Cascadia Mono, Consolas"
                           FontSize="11"
                           VerticalAlignment="Center"
                           TextTrimming="CharacterEllipsis"
                           Foreground="{DynamicResource StatusBarForegroundBrush}"
                           ToolTipService.ShowDuration="20000" />
                <TextBlock x:Name="StatusRightText"
                           Grid.Column="2"
                           Text=""
                           FontSize="11"
                           VerticalAlignment="Center"
                           Foreground="{DynamicResource StatusBarForegroundBrush}" />
            </Grid>
        </Border>


        <ScrollViewer x:Name="PaneScroller" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto"
                      CanContentScroll="False" Focusable="False" SizeChanged="PaneScroller_SizeChanged" ScrollChanged="PaneScroller_ScrollChanged">
        <Grid x:Name="PaneHost" HorizontalAlignment="Left">
        <local:TerminalView x:Name="TerminalTextBox"
                     Background="{DynamicResource TerminalBackgroundBrush}"
                     Foreground="{DynamicResource TerminalForegroundBrush}"
                     BorderThickness="0"
                     Padding="10"
                     FontFamily="Cascadia Mono, Consolas"
                     FontSize="14"
                     Cursor="IBeam"
                     FlowDirection="LeftToRight"
                     TextOptions.TextFormattingMode="Display"
                     TextOptions.TextRenderingMode="ClearType"
                     Typography.StandardLigatures="False"
                     Typography.ContextualLigatures="False"
                     Typography.DiscretionaryLigatures="False"
                     Typography.Kerning="False"
                     Typography.NumeralAlignment="Tabular" />
        </Grid>
        </ScrollViewer>
    </DockPanel>

            <Border x:Name="SearchPanel"
                    Visibility="Collapsed"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Top"
                    Margin="0,60,18,0"
                    Padding="10,6"
                    Background="{DynamicResource SearchPanelBrush}"
                    BorderBrush="{DynamicResource SearchPanelBorderBrush}"
                    BorderThickness="1"
                    CornerRadius="10">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="20" ShadowDepth="3" Opacity="0.35" Color="#000000" />
                </Border.Effect>
                <StackPanel Orientation="Horizontal">
                    <Viewbox Width="14" Height="14" Margin="1,0,8,0" VerticalAlignment="Center">
                        <Path Data="M6.2,1 A5.2,5.2 0 1 0 6.2,11.4 A5.2,5.2 0 1 0 6.2,1 M10.2,10.2 L14,14"
                              Stroke="{DynamicResource MutedForegroundBrush}"
                              StrokeThickness="1.4" StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                    </Viewbox>
                    <Grid Width="196" VerticalAlignment="Center">
                        <TextBlock x:Name="SearchPlaceholder"
                                   Text="Find in terminal"
                                   FontSize="12"
                                   Margin="2,0,0,0"
                                   VerticalAlignment="Center"
                                   IsHitTestVisible="False"
                                   Foreground="{DynamicResource MutedForegroundBrush}" />
                        <TextBox x:Name="SearchBox"
                                 Background="Transparent"
                                 BorderThickness="0"
                                 Padding="0"
                                 FontSize="12"
                                 VerticalContentAlignment="Center"
                                 Foreground="{DynamicResource ChromeStrongForegroundBrush}"
                                 CaretBrush="{DynamicResource ChromeStrongForegroundBrush}"
                                 TextChanged="SearchBox_TextChanged"
                                 PreviewKeyDown="SearchBox_PreviewKeyDown"
                                 AutomationProperties.Name="Find in terminal" />
                    </Grid>
                    <TextBlock x:Name="SearchStatusText"
                               Text=""
                               FontSize="11"
                               MinWidth="52"
                               Margin="8,0,6,0"
                               TextAlignment="Right"
                               VerticalAlignment="Center"
                               Foreground="{DynamicResource StatusBarForegroundBrush}" />
                    <Button x:Name="SearchPreviousButton" Width="24" Height="22" Content="↑" FontSize="12"
                            Style="{StaticResource WindowCaptionButtonStyle}"
                            Click="SearchPrevious_Click" ToolTip="Previous match (Shift+Enter)"
                            AutomationProperties.Name="Previous match" />
                    <Button x:Name="SearchNextButton" Width="24" Height="22" Content="↓" FontSize="12"
                            Style="{StaticResource WindowCaptionButtonStyle}"
                            Click="SearchNext_Click" ToolTip="Next match (Enter)"
                            AutomationProperties.Name="Next match" />
                    <Button Width="24" Height="22" Content="×" FontSize="14"
                            Style="{StaticResource WindowCaptionButtonStyle}"
                            Click="SearchClose_Click" ToolTip="Close search (Esc)"
                            AutomationProperties.Name="Close search" />
                </StackPanel>
            </Border>

            <Grid x:Name="PaletteOverlay"
                  Visibility="Collapsed"
                  Background="{DynamicResource ScrimBrush}"
                  MouseLeftButtonDown="PaletteOverlay_MouseLeftButtonDown">
                <Border Width="540"
                        MaxHeight="430"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Top"
                        Margin="0,92,0,0"
                        Padding="10"
                        Background="{DynamicResource PaletteBackgroundBrush}"
                        BorderBrush="{DynamicResource SearchPanelBorderBrush}"
                        BorderThickness="1"
                        CornerRadius="12">
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="28" ShadowDepth="6" Opacity="0.4" Color="#000000" />
                    </Border.Effect>
                    <DockPanel>
                        <Grid DockPanel.Dock="Top" Margin="4,2,4,6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="⌘" FontSize="14" Margin="0,0,9,0" VerticalAlignment="Center"
                                       Foreground="{DynamicResource MutedForegroundBrush}" />
                            <Grid Grid.Column="1">
                                <TextBlock x:Name="PalettePlaceholder"
                                           Text="Type a command…"
                                           FontSize="13"
                                           VerticalAlignment="Center"
                                           IsHitTestVisible="False"
                                           Foreground="{DynamicResource MutedForegroundBrush}" />
                                <TextBox x:Name="PaletteSearchBox"
                                         Background="Transparent"
                                         BorderThickness="0"
                                         Padding="0"
                                         FontSize="13"
                                         VerticalContentAlignment="Center"
                                         Foreground="{DynamicResource PaletteForegroundBrush}"
                                         CaretBrush="{DynamicResource PaletteForegroundBrush}"
                                         TextChanged="PaletteSearchBox_TextChanged"
                                         PreviewKeyDown="PaletteSearchBox_PreviewKeyDown"
                                         AutomationProperties.Name="Command palette search" />
                            </Grid>
                        </Grid>
                        <Border DockPanel.Dock="Top" Height="1" Background="{DynamicResource HeaderSeparatorBrush}" Margin="2,0,2,6" />
                        <ListBox x:Name="PaletteList"
                                 Background="Transparent"
                                 BorderThickness="0"
                                 MaxHeight="330"
                                 Focusable="False"
                                 ItemContainerStyle="{StaticResource PaletteItemStyle}"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                 MouseLeftButtonUp="PaletteList_MouseLeftButtonUp" />
                    </DockPanel>
                </Border>
            </Grid>
    </Grid>
    </Border>
</Window>
